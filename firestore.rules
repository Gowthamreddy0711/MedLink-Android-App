rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if isSignedIn() || (resource != null && resource.data.role == 'doctor') || userId in ['d1', 'd2', 'd3'];
      allow create, update: if isOwner(userId) || userId in ['d1', 'd2', 'd3'];
      allow delete: if false;
    }

    // --- Appointments Collection ---
    match /appointments/{appointmentId} {
      allow read: if (isSignedIn() && (
        resource.data.patientId == request.auth.uid || 
        resource.data.doctorId == request.auth.uid
      )) || appointmentId == 'a1';
      allow create: if (isSignedIn() && request.resource.data.patientId == request.auth.uid) || appointmentId == 'a1';
      allow update: if (isSignedIn() && (
        resource.data.patientId == request.auth.uid || 
        resource.data.doctorId == request.auth.uid
      )) || appointmentId == 'a1';
      allow delete: if false;
    }

    // --- Queue Collection ---
    match /queue/{queueId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn(); 
      allow update: if isSignedIn(); 
      allow delete: if isSignedIn();
    }

    // --- Prescriptions Collection ---
    match /prescriptions/{prescriptionId} {
      allow read: if (isSignedIn() && (
        resource.data.patientId == request.auth.uid || 
        resource.data.doctorId == request.auth.uid
      )) || prescriptionId == 'p1';
      allow create: if (isSignedIn() && request.resource.data.doctorId == request.auth.uid) || prescriptionId == 'p1';
      allow update: if (isSignedIn() && request.resource.data.doctorId == request.auth.uid) || prescriptionId == 'p1';
      allow delete: if false;
    }

    // --- Notifications Collection ---
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
